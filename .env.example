# O banco compartilhado (Upstash Redis) é configurado direto na Vercel:
# Storage > Upstash for Redis > Connect Project. A integração cria
# KV_REST_API_URL e KV_REST_API_TOKEN, lidas por api/state.js.
# Sem isso o app usa apenas localStorage (alterações ficam só no navegador).
KV_REST_API_URL=
KV_REST_API_TOKEN=
